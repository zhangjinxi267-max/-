# Instagram 账号信息
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# 视频文件夹路径
VIDEO_FOLDER=/path/to/your/videos

# OpenAI API Key (用于生成文案和话题，可选)
OPENAI_API_KEY=your_openai_key

# 上传时间（24小时制，例如: 09:00, 18:30）
UPLOAD_TIME=12:00

# 默认话题（逗号分隔）
DEFAULT_HASHTAGS=instagram,video,viral,reels

# 已上传视频记录文件
UPLOADED_LOG=uploaded_videos.txt
